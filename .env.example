# Copy to .env to override the dev defaults from docker-compose.yml.
POSTGRES_PASSWORD=ledger
PROVIDER_API_KEY=change-me
WEBHOOK_SECRET=change-me
PUBLIC_URL=http://localhost:8001

# Read by wallet-service; docker-compose.yml sets them, so they are needed only outside compose.
# DATABASE_URL=postgresql://ledger:ledger@db:5432/ledger
# PROVIDER_URL=http://provider:8001
# CALLBACK_URL=http://wallet:8000/v1/webhooks/provider

# Nothing loads .env for the tests: export this variable before `uv run pytest`,
# or rely on the same default.
TEST_DATABASE_URL=postgresql://ledger:ledger@localhost:55432/ledger_test
